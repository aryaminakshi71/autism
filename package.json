{
  "name": "spectrumai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "bun run dev:web & bun run dev:api",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium e2e/app.spec.ts e2e/autism.spec.ts e2e/navigation.spec.ts e2e/api-validation.spec.ts e2e/api-contracts.spec.ts e2e/accessibility-gate.spec.ts",
    "test:e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:full": "bun run test:e2e:desktop && bun run test:e2e:mobile",
    "test:e2e:flake": "playwright test --project=chromium --project=mobile-chrome --repeat-each=3",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run test && bun run test:e2e",
    "qa:legacy-terms": "node scripts/qa/legacy-term-guard.mjs",
    "qa:surface-consistency": "node scripts/qa/surface-consistency-guard.mjs",
    "qa:lighthouse": "node scripts/qa/lighthouse-gate.mjs",
    "qa:all": "bun run qa:legacy-terms && bun run qa:surface-consistency",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup:pre-migrate": "node scripts/db/backup-pre-migrate.mjs",
    "db:restore:backup": "node scripts/db/restore-backup.mjs",
    "db:rollback:autism-transition": "node scripts/db/rollback-autism-transition.mjs",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "node scripts/platform-db-check.mjs",
    "db:seed": "node scripts/platform-db-seed.mjs",
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules packages/*/node_modules",
    "health": "node scripts/platform-healthcheck.mjs",
    "security:audit": "bun audit",
    "security:scan": "bunx snyk test",
    "start": "bun run dev",
    "dev:web": "SKIP_CLOUDFLARE=true bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "test:integration": "vitest run src/integration --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.10.0",
    "@orpc/client": "^1.13.4",
    "@orpc/json-schema": "^1.13.4",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/tanstack-query": "^1.13.4",
