    "@scalar/hono-api-reference": "^0.9.40",
    "@sentry/cloudflare": "^10.46.0",
    "@sentry/node": "^10.46.0",
    "@sentry/react": "^10.46.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.90.20",
    "@tanstack/react-router": "1.161.3",
    "@tanstack/react-router-devtools": "^1.158.1",
    "@tanstack/react-router-ssr-query": "^1.158.1",
    "@tanstack/react-start": "1.161.3",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.1",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "dd-trace": "^5.86.0",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "8.5.1",
    "hono": "^4.11.7",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next-themes": "^0.4.6",
    "openai": "^6.21.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.8",
    "posthog-js": "^1.170.0",
    "posthog-node": "^4.15.0",
    "react": "^19.2.0",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.60.0",
    "react-hot-toast": "^2.4.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "dompurify": "^3.2.4",
    "@tanstack/start-client-core": "1.161.3",
    "@platform/email": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vite-plugin": "^1.22.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "^0.5.1",
    "@tanstack/react-router-devtools": "^1.160.2",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.29.0",
    "framer-motion": "^12.34.0",
    "jsdom": "^23.2.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^1.6.0",
    "wrangler": "^4.61.1",
    "@cloudflare/workers-types": "^4.20250109.0"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
