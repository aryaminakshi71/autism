{
  "name": "@autism-legacy-20260205/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_DATABASE=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/autism_db} wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "test:integration": "vitest run src/integration --passWithNoTests",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./context": "./src/context.ts",
    "./router": "./src/routers/index.ts"
  },
  "dependencies": {
    "@autism-legacy-20260205/auth": "file:../../packages/auth",
    "@autism-legacy-20260205/env": "file:../../packages/env",
    "@autism-legacy-20260205/logger": "file:../../packages/logger",
    "@autism-legacy-20260205/storage": "file:../../packages/storage",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "@scalar/hono-api-reference": "^0.9.39",
    "@sentry/node": "^8.0.0",
    "@upstash/ratelimit": "^2.0.7",
    "better-auth": "^1.4.12",
    "dd-trace": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.10",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@autism-legacy-20260205/tsconfig": "file:../../packages/tsconfig",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.63.0"
  }
}
