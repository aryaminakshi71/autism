{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autism",
  "main": "./src/server.ts",
  "compatibility_date": "2025-01-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "development",
    "VITE_PUBLIC_SITE_URL": "http://localhost:3003"
  },
  "routes": [
    {
      "pattern": "autism.aryaminakshi.workers.dev",
      "zone_name": "aryaminakshi.workers.dev"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "placeholder-create-hyperdrive-first",
      "localConnectionString": "postgresql://aryaminakshi:@localhost:5432/crm_db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "placeholder-kv-id"
    }
  ],
  "upstash_redis": [
    {
      "binding": "REDIS",
      "rest_api_url": "https://placeholder.upstash.io",
      "rest_api_token": "placeholder-token"
    }
  ],
  "dev": {
    "port": 3003
  }
}
