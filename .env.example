# App URLs
APP_NAME=Autism
VITE_PUBLIC_APP_NAME=Autism
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_PUBLIC_API_URL=http://localhost:3000/api
VITE_PUBLIC_API_VERSION=1

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-please-change-me-please-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional - only configure if you have credentials)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (Hyperdrive/Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autism

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_PUBLIC_SENTRY_DSN=

# PostHog
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Analytics
VITE_PUBLIC_GA_ID=

# API Protocol
API_VERSION=1
