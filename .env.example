# App URLs
APP_NAME=Autism
VITE_PUBLIC_APP_NAME=Autism
PORT=3109
VITE_PUBLIC_SITE_URL=http://localhost:3109
VITE_PUBLIC_API_URL=http://localhost:3109/api
VITE_PUBLIC_API_VERSION=1

# Auth (Better Auth)
BETTER_AUTH_SECRET=autism_better_auth_secret_change_me_32_chars
BETTER_AUTH_URL=http://localhost:3109

# OAuth Providers (optional - only configure if you have credentials)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (Hyperdrive/Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autism

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_PUBLIC_SENTRY_DSN=

# PostHog
VITE_PUBLIC_POSTHOG_KEY=phc_autism_replace_me
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Analytics
VITE_PUBLIC_GA_ID=

# API Protocol
API_VERSION=1
