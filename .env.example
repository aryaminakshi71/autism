# App URLs
APP_NAME=Autism
VITE_PUBLIC_APP_NAME=Autism
PORT=3003
VITE_PUBLIC_SITE_URL=http://localhost:3003
VITE_PUBLIC_API_URL=http://localhost:3003/api
VITE_PUBLIC_API_VERSION=1
# Local oRPC API used by Vite's development proxy.
VITE_LOCAL_API_URL=http://127.0.0.1:8787

# Notifications (configure one email and one SMS provider in production)
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Encrypted object storage and backup exports
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_ENCRYPTION_KEY_ID=

# Revenue-cycle integration (never commit real clearinghouse credentials)
CLEARINGHOUSE_BASE_URL=
CLEARINGHOUSE_CLIENT_ID=
CLEARINGHOUSE_CLIENT_SECRET=

# Production hosting
PRODUCTION_APP_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=autism_better_auth_secret_change_me_32_chars
BETTER_AUTH_URL=http://localhost:3003
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3003

# OAuth Providers (optional - only configure if you have credentials)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (Hyperdrive/Postgres)
# Native local PostgreSQL default. Override for Docker or hosted databases.
DATABASE_URL=postgresql://127.0.0.1:5432/autism

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_PUBLIC_SENTRY_DSN=

# PostHog
VITE_PUBLIC_POSTHOG_KEY=phc_autism_replace_me
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Analytics
VITE_PUBLIC_GA_ID=

# API Protocol
API_VERSION=1

# ── Read replica (optional) ──────────────────────────────────────────────────
# Point analytics/dashboard reads at a Neon read replica so they don't compete
# with writes. Leave empty to use the primary for everything.
DATABASE_READ_URL=
